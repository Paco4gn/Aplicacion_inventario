RESEND_API_KEY=
SENDGRID_API_KEY=
BREVO_API_KEY=
GOOGLE_SCRIPT_MAIL_URL=
GOOGLE_SCRIPT_MAIL_SECRET=
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_EMAIL=
